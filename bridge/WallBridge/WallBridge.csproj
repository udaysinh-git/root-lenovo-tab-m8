<Project Sdk="Microsoft.NET.Sdk">

  <!-- Laptop side of Lumia Wall's music section: now playing (SMTC), transport, loopback spectrum.
       Serves 127.0.0.1:8770; the tablet reaches it through `adb reverse tcp:8770 tcp:8770`. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>WallBridge</AssemblyName>
    <RootNamespace>WallBridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Stay small in the background: no background GC thread, compact the heap more eagerly. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Management" Version="10.0.12" />
  </ItemGroup>

</Project>
