<Project Sdk="Microsoft.NET.Sdk">

  <!-- Laptop side of Lumia Wall's music section: now playing (SMTC), transport, loopback spectrum.
       Serves 127.0.0.1:8770; the tablet reaches it through `adb reverse tcp:8770 tcp:8770`. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>WallBridge</AssemblyName>
    <RootNamespace>WallBridge</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
  </ItemGroup>

</Project>
